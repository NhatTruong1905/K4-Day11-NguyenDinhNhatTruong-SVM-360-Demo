# Copy to ./.env and fill in. Scripts also read ../cvat/.env if present.

# Local CVAT admin
CVAT_URL=http://localhost:8080
CVAT_ADMIN_USER=admin
CVAT_ADMIN_PASSWORD=change-me

# Kaggle token (KGAT_...) — needed to download the WoodScape subset (Tasks B/C/D).
# Get one at https://www.kaggle.com/settings/api. FishEye8K (Task A) needs no token.
KAGGLE_API_TOKEN=KGAT_xxxxxxxxxxxxxxxxxxxxxxxx
